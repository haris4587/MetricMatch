{
  "name": "metricmatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:contract": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "typecheck": "tsc --noEmit --jsx react-jsx --module ESNext --moduleResolution bundler --target ES2022 --resolveJsonModule --allowSyntheticDefaultImports --skipLibCheck src/*.ts src/*.tsx"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "typescript": "^5.9.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
